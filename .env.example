# Copy to .env.local for local development. NEVER commit real values.

# Public site URL, used for metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Team view (/team). The area stays disabled until ALL THREE are set.
TEAM_USERNAME=
TEAM_PASSWORD=
# At least 32 random characters, e.g. `openssl rand -base64 48`
TEAM_SESSION_SECRET=

# Storage adapter: "postgres" (use on Vercel and any serverless host), "file" (local JSON file,
# prototype only) or "memory" (lost on restart)
STORAGE_DRIVER=file
# Required when STORAGE_DRIVER=postgres. A Postgres connection string including sslmode, e.g.
# postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
# Optional: set to "false" if you run db/schema.sql yourself instead of auto-creating the table
DATABASE_AUTO_MIGRATE=true
# Optional: connections per server instance (default 3)
PG_POOL_MAX=3
# Where the file adapter writes. Must be private and never served publicly.
DATA_DIR=.data

# Email adapter: "console" only in the prototype. No real email is ever sent.
EMAIL_DRIVER=console

# Rate limiter backend: "upstash" (shared across serverless instances) or "memory" (per instance).
# If unset, Upstash is used automatically when its credentials below are present.
RATE_LIMIT_DRIVER=
# From the Upstash Redis console (REST API section). Vercel's Upstash/KV integration sets the
# KV_REST_API_URL and KV_REST_API_TOKEN equivalents, which are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limiting for registration (per client IP)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600

# Analytics placeholder. Stays off until a visitor consents AND a provider is wired in.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_ID=
